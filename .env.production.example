# Environment Configuration for TextCAD Studio

# ============================================
# LLM Provider Configuration
# ============================================

# Available providers: gemini, openai, claude, ollama
LLM_PROVIDER=gemini

# Google Gemini API Key
# Get it from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API Key (optional)
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Claude API Key (optional)
# Get it from: https://console.anthropic.com/
CLAUDE_API_KEY=your-claude-api-key-here

# Ollama API URL (for local LLM)
# Default: http://localhost:11434
OLLAMA_URL=http://localhost:11434

# ============================================
# Server Configuration
# ============================================

# Environment: development, production
FASTAPI_ENV=development

# Enable debug mode
DEBUG=true

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# ============================================
# CAD Settings
# ============================================

# Maximum execution time for CAD generation (seconds)
MAX_EXECUTION_TIME=30

# Maximum model size (bytes) - 100MB default
MAX_MODEL_SIZE=100000000

# ============================================
# Database (Optional - for future use)
# ============================================

# Database URL for storing design history
# SQLite: sqlite:///./cad_studio.db
# PostgreSQL: postgresql://user:password@localhost/cad_studio
DATABASE_URL=sqlite:///./cad_studio.db

# ============================================
# Frontend Configuration
# ============================================

# API endpoint for frontend
REACT_APP_API_URL=http://localhost:8000

# ============================================
# Logging
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json, text
LOG_FORMAT=text
